# ===========================================
# E-Commerce Platform Environment Variables
# ===========================================

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://192.168.6.53:3000

# OTP
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# Frontend (Public API URL for browser to gateway communication)
NEXT_PUBLIC_API_URL=http://192.168.6.53:8080
NEXT_PUBLIC_APP_NAME=GoCarry

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Environment
APP_ENV=development
LOG_LEVEL=debug
