# ===========================================
# E-Commerce Platform Environment Variables
# ===========================================

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_AUTH_DB=ecommerce-auth
MONGODB_USERS_DB=ecommerce-users
MONGODB_PRODUCTS_DB=ecommerce-products
MONGODB_CART_DB=ecommerce-cart
MONGODB_ORDERS_DB=ecommerce-orders
MONGODB_NOTIFICATIONS_DB=ecommerce-notifications
MONGODB_SEARCH_DB=ecommerce-search

# Redis
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Service Ports
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
PRODUCT_SERVICE_PORT=8083
CART_SERVICE_PORT=8084
ORDER_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
SEARCH_SERVICE_PORT=8087

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://192.168.6.53:8081
USER_SERVICE_URL=http://192.168.6.53:8082
PRODUCT_SERVICE_URL=http://192.168.6.53:8083
CART_SERVICE_URL=http://192.168.6.53:8084
ORDER_SERVICE_URL=http://192.168.6.53:8085
NOTIFICATION_SERVICE_URL=http://192.168.6.53:8086
SEARCH_SERVICE_URL=http://192.168.6.53:8087

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://192.168.6.53:3000

# OTP
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# Frontend
NEXT_PUBLIC_API_URL=http://192.168.6.53:8080
NEXT_PUBLIC_APP_NAME=DYNAMO

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Environment
APP_ENV=development
LOG_LEVEL=debug
